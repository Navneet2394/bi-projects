/// Calendar 2023-2025, Indian fiscal year (April-March); IsFestiveSeason = October-November
table DimDate
	lineageTag: 4af56971-22bb-56e1-87d5-3c71dd6c27f5
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: Short Date
		lineageTag: 2bf11a32-95de-5313-8e6c-77525332a7c6
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column DateKey
		dataType: int64
		isHidden
		lineageTag: 9539575b-5989-5514-8f40-aa553e51d2b0
