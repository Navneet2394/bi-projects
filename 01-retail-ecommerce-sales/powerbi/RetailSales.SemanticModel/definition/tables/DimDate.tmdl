	column IsFestiveSeason
		dataType: boolean
		lineageTag: d9776050-ed70-53e1-840e-b701b0e60de3
		summarizeBy: none
		sourceColumn: IsFestiveSeason

		annotation SummarizationSetBy = Automatic

	partition DimDate = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(pDataFolder & "DimDate.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(Blanks, {
				        {"Date", type date},
				        {"DateKey", Int64.Type},
				        {"Year", Int64.Type},
				        {"Quarter", type text},
				        {"MonthNo", Int64.Type},
				        {"Month", type text},
				        {"YearMonth", type text},
				        {"WeekdayNo", Int64.Type},
				        {"Weekday", type text},
				        {"IsWeekend", type logical},
				        {"FiscalYear", type text},
				        {"IsFestiveSeason", type logical}
				    }, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

