		lineageTag: 57fb0fb4-4df9-5b83-94ee-5462f74a9689
		summarizeBy: none
		sourceColumn: Month
		sortByColumn: MonthNo

		annotation SummarizationSetBy = Automatic

	column YearMonth
		dataType: string
		lineageTag: b69fd62a-6e75-57b2-acd2-6f2c1c5e6dfd
		summarizeBy: none
		sourceColumn: YearMonth

		annotation SummarizationSetBy = Automatic

	column WeekdayNo
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: c973d43c-d5d5-59bc-bc53-64e4fe3786b1
		summarizeBy: none
		sourceColumn: WeekdayNo

