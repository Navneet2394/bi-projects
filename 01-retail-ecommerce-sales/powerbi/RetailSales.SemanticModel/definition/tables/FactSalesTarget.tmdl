/// Monthly sales plan per store and category (2024-2025)
table FactSalesTarget
	lineageTag: 31b832cf-18ca-5228-9c7c-3bd072f95bcd

	column MonthStartDate
		dataType: dateTime
		formatString: Short Date
		lineageTag: b5ea11be-db1f-522d-a6a7-134cac7dacf1
		summarizeBy: none
		sourceColumn: MonthStartDate

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column StoreKey
		dataType: int64
		lineageTag: 59fcd747-3fcd-5841-af43-04c4db09f8cd
		summarizeBy: none
		sourceColumn: StoreKey

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column Category
		dataType: string
		lineageTag: b746f44e-ab13-5d75-9489-82d6dceb4dba
		summarizeBy: none
		sourceColumn: Category

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column TargetAmount
		dataType: decimal
		lineageTag: aa7d73ee-5cdc-53ee-82a5-d05309ceb985
		summarizeBy: none
		sourceColumn: TargetAmount

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition FactSalesTarget = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(pDataFolder & "FactSalesTarget.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(Blanks, {
				        {"MonthStartDate", type date},
				        {"StoreKey", Int64.Type},
				        {"Category", type text},
				        {"TargetAmount", Currency.Type}
				    }, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

